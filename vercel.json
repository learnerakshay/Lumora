{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/youtube-transcript.ts": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://lumora-vtwo.onrender.com/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
