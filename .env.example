# Database (Neon PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:password@ep-cool-host.us-east-2.aws.neon.tech/lumora?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-cool-host.us-east-2.aws.neon.tech/lumora?sslmode=require"

# Server Secrets
CLERK_SECRET_KEY="sk_test_..."
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="REPLACE_WITH_SERVER_ONLY_GEMINI_API_KEY"
TAVILY_API_KEY="tvly-..."
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
EMBEDDING_VERSION="v1"

# Ingestion recovery (database-backed claim and stale-attempt recovery)
INGESTION_STALE_AFTER_MS=900000
INGESTION_RECOVERY_INTERVAL_MS=60000
INGESTION_MAX_RECOVERY_ATTEMPTS=2

# YouTube transcripts. Set provider="proxy" on Render to enable the one-attempt
# caption fast path. Keep the relay token server-only and use the same secret as
# YOUTUBE_TRANSCRIPT_PROXY_TOKEN on Render and YOUTUBE_TRANSCRIPT_RELAY_TOKEN on Vercel.
YOUTUBE_TRANSCRIPT_PROVIDER="direct"
YOUTUBE_TRANSCRIPT_PROXY_URL="https://YOUR-VERCEL-DOMAIN.example/api/youtube-transcript"
YOUTUBE_TRANSCRIPT_PROXY_TOKEN="REPLACE_WITH_SHARED_RANDOM_SECRET"
YOUTUBE_TRANSCRIPT_TIMEOUT_MS=25000
YOUTUBE_TRANSCRIPT_RELAY_TOKEN="REPLACE_WITH_SHARED_RANDOM_SECRET"

CHAT_MODEL="gpt-5.6-sol"
CHAT_REASONING_EFFORT="medium"
CHAT_REQUEST_TIMEOUT_MS=60000
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_MS=10000

# Payments (Razorpay Orders — one-time 30-day access purchases, no
# Subscriptions/Autopay). Leave PAYMENTS_ENABLED=false until Phase 2's routes
# and webhook exist; when true, the three RAZORPAY_* secrets below are
# required and validated (see src/lib/env.ts).
PAYMENTS_ENABLED="false"
RAZORPAY_KEY_ID="rzp_test_REPLACE_WITH_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_SERVER_ONLY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_SERVER_ONLY_WEBHOOK_SECRET"
PAYMENTS_CURRENCY="INR"
PLAN_ACCESS_DAYS=30
# TEMPORARY escape hatch ONLY: allows an rzp_test_ key under NODE_ENV=production
# (Render always runs production). Needed for Phase 2 E2E testing before a
# live Razorpay key exists. Must be "false" (the default) outside of that
# window — unset it again once live-mode testing is no longer needed.
ALLOW_RAZORPAY_TEST_KEYS="false"

# Client Environment Variables

VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Application Config
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"
ALLOW_DEMO_PLAN_UPDATE="false"
