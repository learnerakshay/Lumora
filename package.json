{
  "name": "lumora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:ingestion": "tsx --test src/lib/ingestion/*.test.ts",
    "test:retrieval": "tsx --test src/lib/retrieval/*.test.ts",
    "test:chat": "tsx --test src/lib/chat/*.test.ts src/components/workspace/*.test.ts",
    "test:ai": "tsx --test src/lib/ai/*.test.ts",
    "test:usage": "tsx --test src/lib/usage/*.test.ts src/components/usage/*.test.ts",
    "test:resources": "tsx --test src/lib/resources/*.test.ts",
    "test:skills": "tsx --test src/lib/skills/*.test.ts src/components/skills/*.test.ts src/routes/*.test.ts",
    "test:learning": "tsx --test src/lib/learning/*.test.ts src/components/learning/*.test.ts",
    "test:payments": "tsx --test src/lib/payments/*.test.ts",
    "test": "npm run test:ingestion && npm run test:retrieval && npm run test:chat && npm run test:ai && npm run test:usage && npm run test:resources && npm run test:skills && npm run test:learning && npm run test:payments",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "demo:set-plan": "tsx scripts/set-demo-plan.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/express": "^2.1.46",
    "@google/genai": "^2.16.0",
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^6.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "1.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "2.2.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "youtube-transcript": "1.3.1",
    "youtube-transcript-plus": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.185.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
