// Prisma Schema for Lumora Knowledge Operating System

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

enum SourceType {
  PDF
  WEBSITE
  YOUTUBE
  VTT
  TEXT
}

enum SourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProcessingStage {
  CREATED
  QUEUED
  PROCESSING
  FETCHING
  PARSING
  CHUNKING
  READY_FOR_INDEXING
  EMBEDDING
  INDEXING
  COMPLETED
  FAILED
}

enum SourceIndexStatus {
  BUILDING
  READY
  SUPERSEDED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  SENDING
  SUCCESS
  ERROR
}

enum AnswerMode {
  CONCISE
  DETAILED
  CRITICAL
  CREATIVE
}

enum CitationKind {
  DOCUMENT
  WEB
  CALCULATION
}

model Workspace {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?   @default("folder")
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sources   Source[]
  messages  Message[]
  chunks    Chunk[]

  @@index([slug])
  @@index([userId])
}

model Source {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  type        SourceType
  status      SourceStatus  @default(PENDING)
  stage       ProcessingStage @default(CREATED)
  currentVersion Int        @default(1)
  activeIndexId  String?     @unique
  activeIndex    SourceIndex? @relation("ActiveSourceIndex", fields: [activeIndexId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  contents    SourceContent[]
  processingAttempts SourceProcessingAttempt[]
  indexes     SourceIndex[] @relation("SourceIndexes")
  chunks      Chunk[]

  @@index([workspaceId])
  @@index([type])
  @@index([status])
}

model SourceIndex {
  id                String            @id @default(cuid())
  sourceId          String
  source             Source            @relation("SourceIndexes", fields: [sourceId], references: [id], onDelete: Cascade)
  activeForSource   Source?           @relation("ActiveSourceIndex")
  sourceVersion     Int
  chunkVersion      String
  status            SourceIndexStatus @default(BUILDING)
  expectedChunkCount Int
  embeddingProvider String
  embeddingModel    String
  embeddingVersion  String
  vectorDimensions  Int
  indexedAt         DateTime?
  createdAt         DateTime          @default(now())

  chunks Chunk[]

  @@index([sourceId])
  @@index([sourceId, sourceVersion])
  @@index([status])
}

model SourceContent {
  id                  String   @id @default(cuid())
  sourceId            String
  source              Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version             Int      @default(1)
  originalContent     String?  @db.Text
  artifactData        Bytes?
  artifactFileName    String?
  artifactMimeType    String?
  artifactSize        Int?
  sourceUrl           String?
  rawContent          String   @db.Text
  cleanText           String   @db.Text
  parserMetadata      Json?
  parserVersion       String
  checksum            String
  processingStartedAt DateTime?
  processedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sourceId])
  @@unique([sourceId, version])
}

model SourceProcessingAttempt {
  id          String          @id @default(cuid())
  sourceId    String
  source      Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version     Int
  stage       ProcessingStage @default(CREATED)
  errorMessage String?        @db.Text
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  events SourceProcessingEvent[]

  @@unique([sourceId, version])
  @@index([sourceId])
  @@index([stage])
}

model SourceProcessingEvent {
  id        String                  @id @default(cuid())
  attemptId String
  attempt   SourceProcessingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  stage     ProcessingStage
  details   Json?
  createdAt DateTime                @default(now())

  @@index([attemptId])
  @@index([createdAt])
}

model Chunk {
  id          String    @id @default(cuid())
  sourceId    String
  source      Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  indexId     String?
  index       SourceIndex? @relation(fields: [indexId], references: [id], onDelete: Cascade)
  sourceVersion Int      @default(1)
  content     String    @db.Text
  tokenCount  Int       @default(0)
  chunkIndex  Int       @default(0)
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime  @default(now())

  citations   Citation[]

  @@index([sourceId])
  @@index([workspaceId])
  @@index([indexId])
  @@unique([indexId, chunkIndex])
}

model Message {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        MessageRole
  content     String        @db.Text
  mode        AnswerMode    @default(DETAILED)
  status      MessageStatus @default(SUCCESS)
  createdAt   DateTime      @default(now())

  citations   Citation[]

  @@index([workspaceId])
  @@index([createdAt])
}

model Citation {
  id        String       @id @default(cuid())
  messageId String
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunkId   String?
  chunk     Chunk?       @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  title     String
  snippet   String       @db.Text
  kind      CitationKind @default(DOCUMENT)
  score     Float?
  createdAt DateTime     @default(now())

  @@index([messageId])
  @@index([chunkId])
}
