// Prisma Schema for Lumora Knowledge Operating System

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

enum SourceType {
  PDF
  WEBSITE
  YOUTUBE
  VTT
  TEXT
}

enum SourceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProcessingStage {
  CREATED
  QUEUED
  PROCESSING
  FETCHING
  PARSING
  CHUNKING
  READY_FOR_INDEXING
  EMBEDDING
  INDEXING
  COMPLETED
  FAILED
}

enum SourceIndexStatus {
  BUILDING
  READY
  SUPERSEDED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  SENDING
  SUCCESS
  ERROR
}

enum AnswerMode {
  CONCISE
  DETAILED
  CRITICAL
  CREATIVE
}

enum CitationKind {
  DOCUMENT
  WEB
  CALCULATION
}

enum ResponseMode {
  GENERAL
  GROUNDED
}

enum Plan {
  FREE
  CORE
  MAX
}

enum UsageActionType {
  INGESTION
  CHAT
  AI_ACTION
  SKILL_INTELLIGENCE
  LEARNING_PATH
}

enum UsageEventStatus {
  PENDING
  COMMITTED
}

enum SkillProfileStatus {
  EXTRACTING
  READY
  FAILED
}

enum LearningPlanStatus {
  BUILDING
  READY
  FAILED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

enum CouponKind {
  PERCENT
  FIXED
}

model User {
  id                    String         @id
  plan                  Plan           @default(FREE)
  planExpiresAt         DateTime?
  planUpdatedAt         DateTime?
  isFaculty             Boolean        @default(false)
  hasSeenFacultyWelcome Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  usageEvents           UsageEvent[]
  skillProfiles         SkillProfile[]
  learningPlans         LearningPlan[]
  payments              Payment[]
}

model UsageEvent {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType       UsageActionType
  status           UsageEventStatus
  provider         String?
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  createdAt        DateTime         @default(now())
  committedAt      DateTime?

  @@index([userId, actionType, createdAt])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?  @default("folder")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sources  Source[]
  messages Message[]
  chunks   Chunk[]

  learningWorkspaceLinks LearningWorkspaceLink[]

  @@index([slug])
  @@index([userId])
}

model Source {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  type           SourceType
  status         SourceStatus    @default(PENDING)
  stage          ProcessingStage @default(CREATED)
  currentVersion Int             @default(1)
  activeIndexId  String?         @unique
  activeIndex    SourceIndex?    @relation("ActiveSourceIndex", fields: [activeIndexId], references: [id], onDelete: SetNull)
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  contents           SourceContent[]
  processingAttempts SourceProcessingAttempt[]
  indexes            SourceIndex[]             @relation("SourceIndexes")
  chunks             Chunk[]
  citations          Citation[]

  @@index([workspaceId])
  @@index([type])
  @@index([status])
}

model SourceIndex {
  id                 String            @id @default(cuid())
  sourceId           String
  source             Source            @relation("SourceIndexes", fields: [sourceId], references: [id], onDelete: Cascade)
  activeForSource    Source?           @relation("ActiveSourceIndex")
  sourceVersion      Int
  chunkVersion       String
  status             SourceIndexStatus @default(BUILDING)
  expectedChunkCount Int
  embeddingProvider  String
  embeddingModel     String
  embeddingVersion   String
  vectorDimensions   Int
  indexedAt          DateTime?
  createdAt          DateTime          @default(now())

  chunks    Chunk[]
  citations Citation[]

  @@index([sourceId])
  @@index([sourceId, sourceVersion])
  @@index([status])
}

model SourceContent {
  id                  String    @id @default(cuid())
  sourceId            String
  source              Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version             Int       @default(1)
  originalContent     String?   @db.Text
  artifactData        Bytes?
  artifactFileName    String?
  artifactMimeType    String?
  artifactSize        Int?
  sourceUrl           String?
  rawContent          String    @db.Text
  cleanText           String    @db.Text
  parserMetadata      Json?
  parserVersion       String
  checksum            String
  processingStartedAt DateTime?
  processedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([sourceId, version])
  @@index([sourceId])
}

model SourceProcessingAttempt {
  id           String          @id @default(cuid())
  sourceId     String
  source       Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version      Int
  stage        ProcessingStage @default(CREATED)
  errorMessage String?         @db.Text
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  events SourceProcessingEvent[]

  @@unique([sourceId, version])
  @@index([sourceId])
  @@index([stage])
}

model SourceProcessingEvent {
  id        String                  @id @default(cuid())
  attemptId String
  attempt   SourceProcessingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  stage     ProcessingStage
  details   Json?
  createdAt DateTime                @default(now())

  @@index([attemptId])
  @@index([createdAt])
}

model Chunk {
  id            String                       @id @default(cuid())
  sourceId      String
  source        Source                       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspace     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  indexId       String?
  index         SourceIndex?                 @relation(fields: [indexId], references: [id], onDelete: Cascade)
  sourceVersion Int                          @default(1)
  content       String                       @db.Text
  tokenCount    Int                          @default(0)
  chunkIndex    Int                          @default(0)
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now())

  citations Citation[]

  @@unique([indexId, chunkIndex])
  @@index([sourceId])
  @@index([workspaceId])
  @@index([indexId])
}

model Message {
  id                      String        @id @default(cuid())
  workspaceId             String
  workspace               Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentMessageId         String?       @unique
  parentMessage           Message?      @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies                 Message[]     @relation("MessageReplies")
  role                    MessageRole
  content                 String        @db.Text
  mode                    AnswerMode    @default(DETAILED)
  responseMode            ResponseMode?
  resourceRecommendations Json?
  status                  MessageStatus @default(SUCCESS)
  action                  Json?
  regenerationStartedAt   DateTime?
  createdAt               DateTime      @default(now())

  citations Citation[]

  @@index([workspaceId])
  @@index([parentMessageId])
  @@index([createdAt])
}

model SkillProfile {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  version          Int
  status           SkillProfileStatus @default(EXTRACTING)
  sourceKind       String
  // Raw resume text this profile was extracted from, stored so "Re-run
  // analysis" can send it through the extraction pipeline again instead of
  // recomputing from already-extracted output. Null for profiles created
  // before this field existed, and for IMAGE-sourced profiles (no plain
  // text was ever produced) — both cases mean re-analysis cannot run and
  // the route returns a clear "upload again" error instead.
  sourceText       String?            @db.Text
  extraction       Json?
  normalizedSkills Json?
  extractionModel  String?
  contractVersion  String
  errorMessage     String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  analyses RoleAnalysis[]

  @@unique([userId, version])
  @@index([userId])
}

model RoleAnalysis {
  id            String       @id @default(cuid())
  profileId     String
  profile       SkillProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  engineVersion String
  selectedRoles Json
  gaps          Json
  createdAt     DateTime     @default(now())

  learningPlans LearningPlan[]

  @@index([profileId])
}

model LearningPlan {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId     String
  analysis       RoleAnalysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  version        Int
  status         LearningPlanStatus @default(BUILDING)
  roleId         String
  engineVersion  String
  narrativeModel String?
  selectedGapIds Json
  path           Json?
  readiness      Json?
  errorMessage   String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  workspaceLinks LearningWorkspaceLink[]

  @@unique([userId, version])
  @@index([userId])
  @@index([analysisId])
}

model LearningWorkspaceLink {
  id          String       @id @default(cuid())
  planId      String
  plan        LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@unique([planId, workspaceId])
  @@index([planId])
  @@index([workspaceId])
}

model Citation {
  id               String       @id @default(cuid())
  messageId        String
  message          Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunkId          String
  chunk            Chunk        @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  sourceId         String
  source           Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  indexId          String
  index            SourceIndex  @relation(fields: [indexId], references: [id], onDelete: Cascade)
  title            String
  snippet          String       @db.Text
  kind             CitationKind @default(DOCUMENT)
  score            Float?
  sourceUrl        String?      @db.Text
  pageNumber       Int?
  timestampStartMs Int?
  timestampEndMs   Int?
  textOrigin       String
  createdAt        DateTime     @default(now())

  @@index([messageId])
  @@index([chunkId])
  @@index([sourceId])
  @@index([indexId])
}

// One row per purchase attempt (Razorpay Order). A CAPTURED row is both a
// payment-history record and the entitlement grant for [accessFrom, accessUntil) —
// there is no separate subscription/entitlement table. Renewals create a new
// row rather than mutating an existing one.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  amount            Int
  discountAmount    Int           @default(0)
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String?
  failureCode       String?
  failureReason     String?       @db.Text
  accessFrom        DateTime?
  accessUntil       DateTime?
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  signatureVerified Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status, accessUntil])
}

// Idempotency ledger for Razorpay webhooks. The unique eventId is what makes
// webhook delivery (which Razorpay retries for up to 24h) safe to process
// more than once.
model WebhookEvent {
  id                String    @id @default(cuid())
  eventId           String    @unique
  eventType         String
  providerCreatedAt DateTime?
  payload           Json
  processed         Boolean   @default(false)
  errorMessage      String?   @db.Text
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@index([processed, receivedAt])
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  kind            CouponKind
  value           Int
  appliesToPlans  Json
  maxRedemptions  Int?
  redemptionCount Int        @default(0)
  perUserLimit    Int        @default(1)
  validUntil      DateTime?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments Payment[]
}
